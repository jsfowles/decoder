{
  "name": "decoder",
  "private": true,
  "type": "module",
  "description": "A text decode: each letter scrambles through look-alikes of its own width, so the line settles without moving.",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "check": "astro check && prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude"
  },
  "dependencies": {
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/libre-caslon-display": "^5.3.0",
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "sass-embedded": "^1.105.1",
    "typescript": "^5.9.3"
  }
}
